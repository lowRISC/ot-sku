{
  "config_version": 4,
  // Allow one-step ownership transfer from the factory configuration.
  "update_mode": "AnyVersion",
  "sram_exec": "DisabledLocked",
  "min_security_version_bl0": "NoChange",
  "boot_svc_after_wakeup": "True",

  // TODO: Update fake keys to real keys after keygen.
  "ownership_key_alg": "HybridSpxPrehash",
  "owner_key": {
    "Hybrid": {
      "ecdsa": "open/keys/owner/nuvoton-ot00-owner-ecdsa-0.pub.der",
      "spx": "open/keys/owner/nuvoton-ot00-owner-slhdsa-0.pub.pem"
    }
  },
  "activate_key": {
    "Hybrid": {
      "ecdsa": "open/keys/owner/nuvoton-ot00-activate-ecdsa-0.pub.der",
      "spx": "open/keys/owner/nuvoton-ot00-activate-slhdsa-0.pub.pem"
    }
  },
  "unlock_key": {
    "Hybrid": {
      "ecdsa": "open/keys/owner/nuvoton-ot00-unlock-ecdsa-0.pub.der",
      "spx": "open/keys/owner/nuvoton-ot00-unlock-slhdsa-0.pub.pem"
    }
  },
  "data": [
    {
      // Application keys validate owner firmware.
      "ApplicationKey": {
        "key_alg": "HybridSpxPrehash",
        "key_domain": "Prod",
        "usage_constraint": "0x0",
        "key": {
          "Hybrid": {
            "ecdsa": "open/keys/owner/nuvoton-ot00-app-ecdsa-prod-0.pub.der",
            "spx": "open/keys/owner/nuvoton-ot00-app-slhdsa-prod-0.pub.pem"
          }
        }
      },
    },
    {
      // Application keys validate owner firmware.
      "ApplicationKey": {
        "key_alg": "HybridSpxPrehash",
        "key_domain": "Prod",
        "usage_constraint": "0x0",
        "key": {
          "Hybrid": {
            "ecdsa": "open/keys/owner/nuvoton-ot00-app-ecdsa-prod-1.pub.der",
            "spx": "open/keys/owner/nuvoton-ot00-app-slhdsa-prod-1.pub.pem"
          }
        }
      },
    },
    {
      // Data flash layout (512 pages * 2 KiB = 1 MiB):
      // - Pages   0..43 : Slot A ROM_EXT (88 KiB, managed by ROM_EXT).
      // - Pages  44..231: Slot A firmware + detached signature (376 KiB, omitted).
      // - Pages 232..255: Slot A storage (48 KiB, omitted).
      // - Pages 256..299: Slot B ROM_EXT (88 KiB, managed by ROM_EXT).
      // - Pages 300..483: Slot B firmware (368 KiB, configured below).
      // - Pages 484..487: Slot B detached signature (8 KiB, omitted).
      // - Pages 488..511: Slot B storage (48 KiB, omitted).
      "FlashConfig": {
        "config": [
          {
            // Slot B App Firmware region: 600 to 968 KiB.
            "start": 300,
            "size": 184,
            // Permissions: read, erase and program.
            "read": true,
            "program": true,
            "erase": true,
            // Region properties.
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "protect_when_active": true,
            "lock": true
          }
        ]
      },
    },
    {
      // The Flash INFO Config defines how the INFO pages reserved for the
      // owner will be configured.  The configuration properties are the
      // same as the flash region config properties, however the
      // `protect_when_active` flag is meaningless.
      //
      // On the Earlgrey_PROD chip, INFO pages 5 to 8 (inclusive) in
      // banks 0 & 1 are reserved for owner use.
      "FlashInfoConfig": {
        "config": [
          {
            "bank": 0,
            "page": 5,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            "bank": 0,
            "page": 6,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            "bank": 0,
            "page": 7,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            "bank": 0,
            "page": 8,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            "bank": 1,
            "page": 5,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            "bank": 1,
            "page": 6,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            // PERSO page Ext0.
            "bank": 1,
            "page": 7,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          },
          {
            // PERSO page Ext1.
            "bank": 1,
            "page": 8,
            "read": true,
            "program": false,
            "erase": false,
            "scramble": true,
            "ecc": true,
            "high_endurance": false,
            "lock": true
          }
        ]
      },
    },
    {
      // The Rescue Config determines whether the ROM_EXT rescue protocol
      // is enabled and what rescue and boot service commands are permitted.
      "RescueConfig": {
        "protocol": "UsbDfu",
        "trigger": "Strapping",
        "trigger_index": 0x33,
        "enter_on_failure": true,
        "timeout": 30,

        // Pages 44..231 (88 to 464 KiB). Storage at Pages 232..255 stays untouched.
        "start": 44,
        "size": 188,
        // List of rescue and boot service commands permitted by the rescue
        // protocol.  There is no preferred ordering of this list.  Rescue
        // commands and boot service commands have distinct identifiers.
        "command_allow": [
          // Rescue commands:
          "Rescue",             // Rescue firmware upload.
          "GetBootLog",         // Boot log download.
          "BootSvcReq",         // Boot service request upload.
          "BootSvcRsp",         // Boot service response download.
          "OwnerBlock",         // Owner Block (config) upload.
          "GetDeviceId",        // Get the OpenTitan device ID.
          "RescueB",            // Rescue SlotB of the flash.
          "GetOwnerPage0",      // Get the content of owner page 0.
          "GetOwnerPage1",      // Get the content of owner page 1.

          // The following commands are always allowed regardless of the
          // allow-list:
          // "Baud",            // Change the rescue baud rate.
          // "Reboot",          // Reboot.
          // "Wait",            // Don't automatically reboot after data upload.

          // Boot service commands allowed.  These commands can only be sent
          // if the rescue command "BootSvcReq" is allowed.
          "Empty",
          "MinBl0SecVerRequest",
          "NextBl0SlotRequest",
          "OwnershipUnlockRequest",
          "OwnershipActivateRequest"
        ]
      }
    }
  ]
}
